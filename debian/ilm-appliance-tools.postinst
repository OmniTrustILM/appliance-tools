#!/bin/sh

set -e

. /usr/share/debconf/confmodule

# ----------------------------------------------------------------
# Transition: rename OS user czertainly -> ilm on existing appliances
# ----------------------------------------------------------------
if getent passwd czertainly >/dev/null 2>&1 && ! getent passwd ilm >/dev/null 2>&1; then
    echo "Renaming OS user czertainly -> ilm"
    usermod  -l ilm czertainly
    groupmod -n ilm czertainly
    if [ -d /home/czertainly ] && [ ! -d /home/ilm ]; then
        usermod -d /home/ilm -m ilm
    fi
    # remove old sudoers file (new package installs sudoers.d/ilm)
    rm -f /etc/sudoers.d/czertainly
    # remove old dpkg-statoverride entries so they can be re-added with ilm owner
    for P in /etc/czertainly-ansible/vars \
             /etc/czertainly-ansible/vars/czertainly.yml \
             /etc/czertainly-ansible/vars/database.yml \
             /etc/czertainly-ansible/vars/docker.yml \
             /etc/czertainly-ansible/vars/ingress.yml \
             /etc/czertainly-ansible/vars/proxy.yml \
             /etc/czertainly-ansible/vars/trustedCA.yml \
             /etc/czertainly-ansible/vars/email.yml \
             /etc/czertainly-ansible/vars/network.yml \
             /etc/czertainly-ansible/vars/ntp.yml; do
        if dpkg-statoverride --list "$P" >/dev/null 2>&1; then
            dpkg-statoverride --remove "$P"
        fi
    done
fi

# allow ilm user to modify variables
if ! dpkg-statoverride --list /etc/czertainly-ansible/vars >/dev/null 2>&1
then
  dpkg-statoverride --update --add ilm ilm 775 /etc/czertainly-ansible/vars
fi

for F in /etc/czertainly-ansible/vars/czertainly.yml /etc/czertainly-ansible/vars/database.yml /etc/czertainly-ansible/vars/docker.yml /etc/czertainly-ansible/vars/ingress.yml /etc/czertainly-ansible/vars/proxy.yml /etc/czertainly-ansible/vars/trustedCA.yml /etc/czertainly-ansible/vars/email.yml /etc/czertainly-ansible/vars/network.yml /etc/czertainly-ansible/vars/ntp.yml
do
  if ! dpkg-statoverride --list $F  >/dev/null 2>&1
  then
    dpkg-statoverride --update --add ilm ilm 664 $F
  fi
done

# Remove the abandoned Helm repo file if it exists
REPO_FILE="/etc/apt/sources.list.d/baltocdn_com_helm_stable_debian.list"
if [ -f "$REPO_FILE" ]; then
    rm -f "$REPO_FILE"
    echo "Removed abandoned Helm apt repository: $REPO_FILE"

    # Remove keyring if previously removed repo was using it
    KEYRING="/usr/share/keyrings/helm.asc"
    if [ -f "$KEYRING" ]; then
        rm -f "$KEYRING"
        echo "Removed Helm keyring: $KEYRING"
    fi
fi


# Transition: ensure /etc/appliance_version is the canonical file and
# /etc/czertainly_appliance_version is a backward-compat symlink.
if [ -f /etc/czertainly_appliance_version ] && [ ! -L /etc/czertainly_appliance_version ]; then
    # Upgrading from an old appliance: promote old file to new name, replace with symlink
    if [ ! -e /etc/appliance_version ]; then
        mv /etc/czertainly_appliance_version /etc/appliance_version
    else
        rm /etc/czertainly_appliance_version
    fi
    ln -s /etc/appliance_version /etc/czertainly_appliance_version
fi

#DEBHELPER#
