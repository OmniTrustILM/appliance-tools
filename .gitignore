*~
*.deb
# unpacked by build-deb.sh from the tarballs in vendor/
usr/share/ilm-ansible/collections/
vendor/requirements.yml
# Only what a build leaves behind. Named one by one on purpose: a pattern like
# debian/ilm-appliance-tools.* covers the build artefacts but also .postinst
# and .maintscript, which are sources - a new one of those would be ignored
# without a word and would be missing from a fresh clone.
debian/.debhelper/
debian/debhelper-build-stamp
debian/files
debian/copyright
debian/czertainly-appliance-tools/
debian/ilm-appliance-tools/
debian/*.substvars
debian/*.debhelper
debian/*.debhelper.log
# generated by build-deb.sh out of the tree
debian/install
debian/*.install

